# Shell/Render variables. ASP.NET Core does not automatically load .env.
# Never use an Azure connection here. Create an EMPTY Neon demo database.
ASPNETCORE_ENVIRONMENT=Production
PORT=10000
ConnectionStrings__DefaultConnection=Host=ep-YOUR-ENDPOINT-pooler.YOUR-REGION.aws.neon.tech;Port=5432;Database=auctionpilot_demo;Username=YOUR_ROLE;Password=SET_IN_RENDER;SSL Mode=VerifyFull;Maximum Pool Size=5;Minimum Pool Size=0;Connection Idle Lifetime=30;Timeout=30;Command Timeout=30
Jwt__Key=
Jwt__Issuer=AuctionAPI
Jwt__Audience=AuctionClient
CORS_ALLOWED_ORIGINS=https://auction-pilot.vercel.app
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
Proxy__TrustRender=true
# Explicit first boot ONLY on the isolated, empty demo database. Set false after initialization.
Database__ApplyMigrations=false
Database__SeedDemo=false
AdminSeed__Email=
AdminSeed__Password=
# Legacy aliases JWT_KEY / ADMIN_EMAIL / ADMIN_PASSWORD remain supported.
# LOCAL isolated cluster: ASPNETCORE_ENVIRONMENT=Development, PORT=62628,
# ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=55439;Database=auctionpilot_demo;Username=postgres;Maximum Pool Size=5
# CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
